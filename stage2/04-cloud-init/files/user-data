## Run arbitrary commands at rc.local like time
runcmd:
  # BUG-040: a `cat >> /etc/bluetooth/main.conf` used to live here, appending a
  # SECOND "# Eatabit BLE Configuration" [General] section on first boot -- on top
  # of the one stage3/08-ble-config/00-run.sh already wrote at image-build time.
  # Every fielded device therefore carries TWO eatabit blocks and THREE [General]
  # sections; verified on v1.0.10, v1.1.0 and v1.1.4 units, byte-identical on all.
  #
  # It contributed nothing. Of its four keys, DiscoverableTimeout and PairableTimeout
  # were already set to the same values by the stage3 block, and InitiallyPowered and
  # Pairable are NOT BlueZ options at all -- bluetoothd logs "Unknown key
  # InitiallyPowered for group General" and the same for Pairable on every boot.
  #
  # Removed so a freshly flashed device ends up with exactly ONE managed block and
  # lands on the field patch's FIXED_CONF_BLOCK_SHA, which is what makes the patch
  # no-op on a reflashed device instead of hitting its refusal path.

  - |
    # Store device ID from CPU serial
    DEVICE_ID=$(awk '/Serial/ {print $3}' /proc/cpuinfo)
    if [ -n "$DEVICE_ID" ]; then
      echo "$DEVICE_ID" > /usr/local/lib/eatabit/deviceid
      chmod 644 /usr/local/lib/eatabit/deviceid
      echo "Device ID stored: $DEVICE_ID"
    else
      echo "Warning: Could not read device ID from /proc/cpuinfo"
    fi

  - |
    # Enable infinite WiFi autoconnect retries for all WiFi profiles
    # Default is 4 retries then give up — causes devices in poor-signal
    # locations to permanently disconnect until rebooted
    for con in $(nmcli -t -f NAME,TYPE con show | awk -F: '$2=="802-11-wireless"{print $1}'); do
      nmcli con modify "$con" connection.autoconnect yes connection.autoconnect-retries 0
    done

  - npm install -g aws-iot-device-sdk-v2 # AWS IoT SDK
  - npm install -g @ngrok/ngrok # Ngrok package
  - npm install -g @abandonware/bleno # BLE package
  - node /usr/local/lib/eatabit/bin/iot-provision.js # Provision device In AWS IoT
  - reboot # Reboot