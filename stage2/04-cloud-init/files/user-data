## Run arbitrary commands at rc.local like time
runcmd:
  - |
    # Store device ID from CPU serial
    DEVICE_ID=$(awk '/Serial/ {print $3}' /proc/cpuinfo)
    if [ -n "$DEVICE_ID" ]; then
      echo "$DEVICE_ID" > /usr/local/lib/eatabit/deviceid
      chmod 644 /usr/local/lib/eatabit/deviceid
      echo "Device ID stored: $DEVICE_ID"
    else
      echo "Warning: Could not read device ID from /proc/cpuinfo"
    fi

  - |
    # Wait for USB printer to be detected (up to 30 seconds)
    for i in {1..30}; do
      if [ -e /dev/usb/lp0 ]; then
        echo "USB printer detected"
        break
      fi
      sleep 1
    done
    
    # Detect printer URI
    PRINTER_URI=$(lpinfo -v | grep -i usb | head -n1 | awk '{print $2}')
    
    if [ -n "$PRINTER_URI" ]; then
      echo "Found printer at: $PRINTER_URI"
      
      # Add printer to CUPS
      lpadmin -p thermal_printer \
        -v "$PRINTER_URI" \
        -E \
        -m raw
      
      # Set as default printer
      lpoptions -d thermal_printer
      
      # Enable and accept jobs
      cupsenable thermal_printer
      cupsaccept thermal_printer
      
      echo "Thermal printer configured in CUPS"
    else
      echo "Warning: No USB printer detected"
    fi

  - npm install -g aws-iot-device-sdk-v2 # Install AWS IoT SDK
  - node /usr/local/lib/eatabit/bin/iot-provision.js # Provision device In AWS IoT
  - reboot # Reboot