IMG_NAME="raspios-trixie-armh64"
PI_GEN_RELEASE="eatabitv001"
RELEASE="trixie"
DEPLOY_COMPRESSION="none"
STAGE_LIST="stage0 stage1 stage2 stage3"
ENABLE_SSH="1"
ENABLE_CLOUD_INIT="1"
export EATABIT_ROOT_DIR="/usr/local/lib/eatabit"

# BUG-042: pi-gen's build.sh defaults TIMEZONE_DEFAULT to Europe/London, which shipped a
# UK clock to every gateway regardless of where it is installed (11 h off in Hawaii).
# build.sh sources this file before applying its ${TIMEZONE_DEFAULT:-...} fallback, so
# setting it here wins without editing upstream pi-gen. UTC fleet-wide: comparable to
# cloud Event rows, and no DST discontinuity.
TIMEZONE_DEFAULT="Etc/UTC"
